# Copy to .env:  cp .env.example .env

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=forensight
MYSQL_USER=forensight
MYSQL_PASSWORD=change-me
DATABASE_URL=mysql+pymysql://forensight:change-me@mysql:3306/forensight

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Paths inside containers
STORAGE_DIR=/storage
MODELS_DIR=/models

# Set to true to install PyTorch etc. into the backend/worker image (large, slower build)
INSTALL_ML=false

# Upload limit in MB
MAX_UPLOAD_MB=200

# Frontend -> API
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
